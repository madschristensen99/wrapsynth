# Hostinger serves static JS with Cache-Control: max-age=604800 (7 days), which
# leaves browsers on stale ES modules after a deploy. Force revalidation instead;
# ETag/Last-Modified still allow cheap 304 responses.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|mjs|json|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header unset Expires
  </FilesMatch>
</IfModule>

# Clean URLs: /account -> account.html, /app -> app.html, /lp-vault -> lp-vault.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^account/?$ account.html [L]
  RewriteRule ^app/?$ app.html [L]
  RewriteRule ^lp-vault/?$ lp-vault.html [L]
</IfModule>
