# WrapSynth LP Node Configuration
# Copy this file to .env and fill in your values

# Required: Private key of the LP vault wallet (0x...)
PRIVATE_KEY=

# Per-chain RPC URLs (comma-separated fallbacks). chains.json lists every
# chain to run; these env vars override its rpcUrls.
BNB_RPC_URLS=https://bsc-dataseed.binance.org
BASE_RPC_URLS=https://mainnet.base.org
ROBINHOOD_RPC_URLS=

# Kick watcher (see README — the protocol is oracle-free; no price pushes)
# KICK_WATCH=1                set 0 to disable
# KICK_WATCH_POLL_MS=30000
# KICK_AUTOCANCEL=false       auto-cancel kicks on our vault during GRACE
# KICK_DEPOSIT_RAW=10000      raw collateral deposited per auto-cancel
# SEEDED_BIDDER=false         bid on auctions for liveness
# SEEDED_BIDDER_MIN_X_BPS=7000

# HTTP server port (default: 3001)
PORT=3001

# Burn auto-processing
AUTO_PROCESS_BURNS=false
BURN_PROPOSE_DELAY_MS=5000
BURN_FINALIZE_DELAY_MS=30000

# LP Ed25519 public keys for burn operations (hex, 64 chars, optional if passing per-request)
BURN_LP_PUBLIC_SPEND_KEY=
BURN_LP_PUBLIC_VIEW_KEY=

# Monero wallet RPC URL (required for real XMR operations)
# The LP server needs a running monero-wallet-rpc instance to:
#   - Scan for incoming XMR deposits before approving mints
#   - Send XMR to users before finalizing burns
#
# HOW TO START monero-wallet-rpc:
#   monero-wallet-rpc --wallet-file /path/to/your/lp-wallet --password <wallet_password> \
#     --rpc-bind-port 18082 --disable-rpc-login \
#     --daemon-address node.moneroworld.com:18089
#
# If you use --rpc-login user:pass instead of --disable-rpc-login,
# set MONERO_WALLET_RPC_USER and MONERO_WALLET_RPC_PASSWORD below.
MONERO_WALLET_RPC_URL=

# Optional: Comma-separated list of Monero daemon URLs for height queries
# Defaults to several public nodes if not set
# MONERO_DAEMON_URLS=https://xmr-node.cakewallet.com:18081,https://node.moneroworld.com:18081

# Optional: Monero daemon address for wallet-rpc (host:port format, no https://)
# Defaults to xmr-node.cakewallet.com:18081 if not set
# MONERO_DAEMON_ADDRESS=xmr-node.cakewallet.com:18081

# Optional: monero-wallet-rpc HTTP basic auth (only if --rpc-login is enabled)
# MONERO_WALLET_RPC_USER=
# MONERO_WALLET_RPC_PASSWORD=

# Optional: dedicated deposit-scan monero-wallet-rpc (auto-spawned by the
# server on startup — hosts only per-mint view-only wallets so deposit
# scanning never evicts the main LP wallet). Override port/dir only if
# 18083 conflicts with something on your host.
# DEPOSIT_WALLET_RPC_URL=http://127.0.0.1:18083
# DEPOSIT_WALLET_RPC_PORT=18083
# DEPOSIT_WALLET_DIR=/path/to/lp-server-js/monero-wallets-deposit

# ─── Monero wallet identity ─────────────────────────────────────────────────
# Name of the LP wallet file inside lp-server-js/monero-wallets/
MONERO_WALLET_NAME=lp-wallet

# Password protecting the wallet's .keys file. NEVER use a default/placeholder value
# here — that file holds the Monero spend key. Generate with: openssl rand -hex 24
# Required by create-monero-wallet.js; weak values are rejected.
MONERO_WALLET_PASSWORD=

# Your wallet's private keys. Back these up offline and never commit them.
# (These live only in .env, which is gitignored.)
MONERO_SPEND_KEY=
MONERO_VIEW_KEY=
